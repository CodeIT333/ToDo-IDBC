@using APP.Services

@page "/"
@inject HttpClient HttpClient
@inject ToDoItemService service

<PageTitle>Home</PageTitle>

<h1>To-Do Item List</h1>

 <div class="toggle-container">
    <label class="switch">
        <input type="checkbox" checked="@isDone" @onchange="ToggleIsDone">
        <span class="slider"></span>
    </label>
    <span>@(isDone ? "Show Completed" : "Show Incomplete")</span>
</div>

<button class="btn btn-primary" @onclick="ShowAddModal">Add New To-Do Item</button>

@if (showAddModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New To-Do Item</h5>
                    <button type="button" class="btn-close" @onclick="HideAddModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="newItem" OnValidSubmit="AddToDoItemAsync">
                        <DataAnnotationsValidator></DataAnnotationsValidator>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="newItem.name" />
                            <ValidationMessage For="@(() => newItem.name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="newItem.description" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Priority</label>
                            <InputSelect class="form-select" @bind-Value="newItem.priority">
                                <option value="1">Low</option>
                                <option value="2">Medium</option>
                                <option value="3">High</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => newItem.priority)" />
                        </div>

                        <button type="submit" class="btn btn-success">Add</button>
                        <button type="button" class="btn btn-secondary" @onclick="HideAddModal">Cancel</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@if (!items.Any())
{
<p>No to-do items found :c</p>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Priority</th>
            <th>Created At</th>
            <th>Is Done</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.name</td>
                <td>@item.description</td>
                <td>@item.priority</td>
                <td>@item.createdAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(item.isDone ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    private bool isDone = false;
    private bool showAddModal = false;

    List<ToDoItemList> items = new();
    private ToDoItemCreate newItem = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadToDoItemsAsync();
    }

    private async Task LoadToDoItemsAsync()
    {
        items = await service.ListToDoItemsAsync(isDone);
    }

    private async Task ToggleIsDone(ChangeEventArgs e)
    {
        isDone = (bool)e.Value;
        await LoadToDoItemsAsync();
    }

    private void ShowAddModal()
    {
        newItem = new ToDoItemCreate();
        showAddModal = true;
    }

    private void HideAddModal()
    {
        showAddModal = false;
    }

    private async Task AddToDoItemAsync()
    {
        var response = await service.CreateToDoItemAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            showAddModal = false;
            await LoadToDoItemsAsync();
        }
    }
}